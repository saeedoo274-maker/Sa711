# ============================================================
#  انسخ هذا الملف باسم .env وعبّي القيم
#  ⚠️ ممنوع منعًا باتًا وضع أي من هذه القيم داخل الكود أو رفعها على Git
# ============================================================

# --- Discord ---
BOT_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# آيديات المطورين، مفصولة بفاصلة. أعلى صلاحية في النظام.
DEVELOPER_IDS=

# سيرفر التطوير لنشر أوامر السلاش فورًا أثناء التطوير (اتركه فاضي للنشر العام)
DEV_GUILD_ID=

# --- Database ---
# مسار قاعدة بيانات SQLite. للانتقال إلى Postgres/MySQL راجع ARCHITECTURE.md
DATABASE_PATH=./data/bot.db

# --- Dashboard (المرحلة 10 - غير مفعّل بعد) ---
SESSION_SECRET=
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000

# --- General ---
NODE_ENV=development
LOG_LEVEL=info
