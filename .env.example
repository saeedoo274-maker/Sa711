# ============================================================
#  انسخ هذا الملف باسم .env وعبّي القيم
#  ⚠️ ممنوع منعًا باتًا وضع أي من هذه القيم داخل الكود أو رفعها على Git
# ============================================================

# --- Discord ---
BOT_TOKEN=
CLIENT_ID=
CLIENT_SECRET=

# آيديات المطورين، مفصولة بفاصلة. أعلى صلاحية في النظام.
DEVELOPER_IDS=

# سيرفر التطوير لنشر أوامر السلاش فورًا أثناء التطوير (اتركه فاضي للنشر العام)
DEV_GUILD_ID=

# --- Database ---
# مسار قاعدة بيانات SQLite. للانتقال إلى Postgres/MySQL راجع ARCHITECTURE.md
DATABASE_PATH=./data/bot.db

# --- لوحة التحكم و REST API (docs/DASHBOARD.md) ---
# سر توقيع الجلسات: 32 حرفًا عشوائيًا على الأقل (بدونه تبقى اللوحة معطّلة)
SESSION_SECRET=
# المنفذ عند التشغيل المحلي (منصات الاستضافة تمرر PORT تلقائيًا)
DASHBOARD_PORT=3000
# الرابط العام؛ أضف <DASHBOARD_URL>/auth/callback في Redirects بوابة ديسكورد
DASHBOARD_URL=http://localhost:3000
# خلف وكيل عكسي (Nginx/Cloudflare) لقراءة IP الحقيقي في حدود المعدل
TRUST_PROXY=false

# --- التكاملات (اختياري) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- النسخ الاحتياطي لملف القاعدة ---
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=10

# --- General ---
NODE_ENV=development
LOG_LEVEL=info
